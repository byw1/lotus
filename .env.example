# ---------------------------------------------------------------------------
# Los Angeles Lotus Festival — environment configuration
#
# Copy to `.env.local` and fill in. `.env*` is git-ignored; never commit real
# values. Everything below is optional: with an empty .env.local the site still
# builds and runs, forms validate, and submissions are logged to the server
# console instead of being emailed.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Preview gate ----------------------------------------------------------
# The shared password for the staging site at /team.
# The public homepage stays "coming soon" while PREVIEW_MODE is on.
#
# This is a soft gate over content that is about to be public anyway. It keeps
# an unfinished site out of search results and away from casual visitors — it
# is not authentication, and nothing sensitive should ever go behind it.
#
# In development, leaving this blank falls back to "Lotus2027" so a fresh
# clone runs with no setup. In production there is NO fallback: with this
# unset the gate refuses everyone, which is the safe direction to fail in.
PREVIEW_PASSWORD="Lotus2027"

# Secret used to sign the preview session cookie (HMAC-SHA256).
# Generate one with:  openssl rand -base64 48
PREVIEW_SESSION_SECRET=""

# Set to "false" to launch the full site publicly and retire the gate.
PREVIEW_MODE="true"

# --- Email (Resend) --------------------------------------------------------
# https://resend.com/api-keys — leave blank in development.
RESEND_API_KEY=""

# Verified sending identity. Until a domain is verified in Resend you can only
# send to your own account address from "onboarding@resend.dev".
EMAIL_FROM="Los Angeles Lotus Festival <no-reply@lotusfestivalla.com>"

# Where application + newsletter notifications are delivered internally.
EMAIL_TO="lotus.festival@lacity.org"

# Optional. Resend replaced Audiences with Segments (how you organize
# contacts) and Topics (what a subscriber can opt in and out of). A Topic is
# what gives subscribers a real preference centre and a compliant unsubscribe,
# which matters for a nonprofit working with the City.
# https://resend.com/docs/dashboard/segments/migrating-from-audiences-to-segments
RESEND_SEGMENT_ID=""
RESEND_TOPIC_ID=""

# --- Spam protection (optional) --------------------------------------------
# Cloudflare Turnstile. If both are blank, Turnstile is skipped entirely and
# only the honeypot + submit-timing heuristics run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting (optional) ----------------------------------------------
# Without these, an in-memory limiter is used. That is fine for a single
# long-lived server but resets on every cold start in serverless.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# The header your proxy guarantees carries the client's address, and the only
# one the rate limiter will read when set. Leave blank locally.
#
# Set it to whatever your platform actually documents, because the default
# guess — leftmost "x-forwarded-for" — is only trustworthy where the edge
# overwrites that header. On Railway the documented header is "x-real-ip" and
# nothing sets "x-forwarded-for", so a caller can send their own and collect a
# fresh rate-limit budget per fabricated address. On Vercel, leave this blank.
CLIENT_IP_HEADER=""
